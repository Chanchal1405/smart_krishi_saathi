rules_version = '2';

// Smart Krishi Saathi — Firestore Security Rules
// -----------------------------------------------------------------------
// Deploy with: firebase deploy --only firestore:rules
// (after `firebase init firestore` in this project, pointing at this file).
//
// Data model:
//   /farmers/{uid}                    -> profile doc, has a "role" field:
//                                         "farmer" | "operator" | "admin"
//   /farmers/{uid}/data/{key}         -> that farmer's private app data
//                                         (calendar, soil records, etc.)
//   /publicData/{docId}               -> admin-managed shared content:
//                                         advisory info, schemes, sample
//                                         market data, buyer listings,
//                                         processing facilities
//   /supportTickets/{ticketId}        -> ticket has "farmerUid" field
//
// SECURITY PRINCIPLE: admin/operator access is granted ONLY by checking the
// "role" field stored on the requester's own /farmers/{uid} doc — which
// only an existing admin (or a trusted server-side script, see
// ADMIN_SETUP.md) can set. The frontend "Admin Mode" toggle is never
// trusted; these rules are the real enforcement point.

function isSignedIn() {
  return request.auth != null;
}
function isOwner(uid) {
  return isSignedIn() && request.auth.uid == uid;
}
function role() {
  return isSignedIn()
    ? get(/databases/$(database)/documents/farmers/$(request.auth.uid)).data.role
    : null;
}
function isAdmin() { return role() == "admin"; }
function isOperatorOrAdmin() { return role() == "operator" || role() == "admin"; }

service cloud.firestore {
  match /databases/{database}/documents {

    match /farmers/{uid} {
      // A farmer can read/update their own profile; admins can read/manage any.
      allow read: if isOwner(uid) || isOperatorOrAdmin();
      allow create: if isOwner(uid); // role defaults to "farmer" at signup — see ADMIN_SETUP.md for promoting an admin
      // Nobody may change their own "role" field client-side — only an
      // admin (via console/Cloud Function) or another admin doc write can.
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role)
                    || isAdmin();
      allow delete: if isAdmin();

      match /data/{key} {
        // Strictly private to the owning farmer — never readable by other
        // farmers, and readable by admins only for support purposes.
        allow read, write: if isOwner(uid);
        allow read: if isOperatorOrAdmin();
      }
    }

    match /publicData/{docId} {
      // Advisory content, schemes, sample market data, buyer/processing
      // listings: readable by every signed-in farmer, editable only by
      // operators/admins.
      allow read: if isSignedIn();
      allow write: if isOperatorOrAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.farmerUid == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.farmerUid == request.auth.uid || isOperatorOrAdmin());
      allow update, delete: if isOperatorOrAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
